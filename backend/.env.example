ENVIRONMENT=development
# Supabase: use the Session pooler URL (Project Settings > Database > Connect).
# URL-encode special characters in the password.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Used only when DATABASE_URL is empty. Postgres.app defaults to 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskflow_db
SECRET_KEY=replace-this-with-a-generated-secret-key-at-least-32-characters
MAILTRAP_HOST=
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASSWORD=
EMAIL_FROM=noreply@tasktion.app
ADMIN_SECRET=your_secure_admin_secret_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
SCHEDULER_ENABLED=true
