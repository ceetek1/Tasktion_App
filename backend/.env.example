ENVIRONMENT=development
# Supabase: use the Session pooler URL (Project Settings > Database > Connect).
# URL-encode special characters in the password.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Used only when DATABASE_URL is empty. Postgres.app defaults to 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskflow_db

# Supabase Auth (Project Settings > API). The publishable/anon key is public by design.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Only for projects still on the legacy HS256 JWT secret; leave blank to use the project's signing keys.
SUPABASE_JWT_SECRET=
# You: joins the group on first sign-in. Everyone else needs an invite link.
FIRST_MEMBER_EMAIL=you@example.com
# Public address of the app; used in invite links and reminder emails.
APP_URL=http://localhost:8000
INVITE_EXPIRE_DAYS=7

# Reminder emails (e.g. Brevo: smtp-relay.brevo.com, port 587). Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=you@example.com
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
SCHEDULER_ENABLED=true
